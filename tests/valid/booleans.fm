Flag = false;
N = Flag ? 2 : 3;
Mask : bool [2, N] = zeros();
A : float [2, N] = ones();
B : float [2, N] = zeros();
Cast = cast<bool>(A);
Back = cast<float>(Mask);
Not = !Mask;
And = Mask && true;
Or = Mask || false;
Select = Mask ? A : B;
PredicateSelect = isfinite(A) ? A : B;
Any = any(Mask, 1);
All = all(Mask, 1);
True = cast<bool>(true);
False = cast<bool>(false);
EqScalar = Mask == true;
EqScalarLeft = false == Mask;
SelectScalar = Mask ? Mask : false;
SelectScalarLeft = Mask ? true : Mask;
ExplicitBool = Mask == cast<bool>(1);
