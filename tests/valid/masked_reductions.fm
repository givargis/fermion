A : double [2,3];
M : bool [2,3];
Row : bool [3];
Col : bool [2,1];
One : bool [1,1];
Raw : bool [3,2];
E : double [0,3];
RMIN = reduce_min(A,-1,M);
RMAX = reduce_max(A,-1,M);
RSUM = sum(A,-1,M);
RCOUNT = count(A,-1,M);
RPRODUCT = product(A,-1,M);
RANY = any(A,-1,M);
RALL = all(A,-1,M);
BroadcastRow = sum(A,1,Row);
BroadcastCol = sum(A,1,Col);
BroadcastOne = sum(A,1,One);
Sliced = sum(A,1,M[::-1,::-1]);
Permuted = sum(A,1,Raw{1,0});
Computed = sum(A,1,!M);
ScalarMask = sum(A,1,any(Row,0));
Empty = sum(E,1,One);
Unmasked = sum(A,1);
