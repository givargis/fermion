A : double [3];
U : double [1,3];
One : double [1];
Empty : double [0,3];
B = broadcast(A,[2,3]);
Same = broadcast(U,[1,3]);
Expanded = broadcast(U,[2,3]);
Reverse = broadcast(A[::-1],[2,3]);
Offset = broadcast(A[1:2],[2,3]);
Nested = broadcast(B,[4,2,3]);
Sliced = B[1,::-1];
Permuted = B{1,0};
Scalar = A[1];
ScalarSame = broadcast(Scalar,[]);
ScalarExpanded = broadcast(Scalar,[2,3]);
EmptyView = broadcast(One,[0,3]);
EmptyInput = broadcast(Empty,[2,0,3]);
EmptyHuge = broadcast(One,[9223372036854775807,2,0]);
ComputedShape = broadcast(A,[ndim(A)+1,numel(A)]);
Flat = flatten(B);
Reshaped = reshape(B,[3,2]);
Plus = B+B;
Sum = sum(B,0);
