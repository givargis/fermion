A : double [2, 3] = uniform();
I : long [2, 3] = zeros();

IsInf = isinf(A);
IsNan = isnan(A);
IsNormal = isnormal(A);
SignBit = signbit(A);
Ceil = ceil(A);
Floor = floor(A);
Round = round(A);
Trunc = trunc(A);
Exp = exp(A);
Exp2 = exp2(A);
Log = log(A);
Log1p = log1p(A);
Sqrt = sqrt(A);
Sin = sin(A);
Erf = erf(A);
Lgamma = lgamma(A);
Tgamma = tgamma(A);
Min = min(A, 0.0);
Max = max(A, 0.0);
Atan2 = atan2(A, 1.0);
Pow = pow(A, 2.0);

Abs = abs(A);
Acos = acos(A);
Asin = asin(A);
Atan = atan(A);
Clamp = clamp(A, 0.0, 1.0);
Copysign = copysign(A, -1.0);
Cos = cos(A);
Erfc = erfc(A);
Gelu = gelu(A);
IsFinite = isfinite(A);
Relu = relu(A);
Sigmoid = sigmoid(A);
Silu = silu(A);
Softplus = softplus(A);
Tan = tan(A);

Sum = sum(A, 1);
Count = count(A, 1);
Product = product(A, 1);
ReduceMin = reduce_min(A, 1);
ReduceMax = reduce_max(A, 1);
Argmin = argmin(A, 1);
Argmax = argmax(A, 1);
Any = any(A, 1);
All = all(A, 1);
Concat = concat(A, A, 1);
Gather = gather(A, I, 1);
Scatter = scatter(A, I, A, 1);

Ndim : long [ndim(A)];
Numel : long [numel(A)];
Shape : long [shape(A, 1)];
Flatten = flatten(A);
Unsqueeze = unsqueeze(A, 0);
Squeeze = squeeze(Unsqueeze, 0);
Cumsum = cumsum(A, 1);
Cumprod = cumprod(A, 1);
Sec = sec(A);
Cot = cot(A);
NormalCdf = normal_cdf(A);
NormalSf = normal_sf(A);
Argsort = argsort(A, 1, false);
Topk = topk(A, 2, 1, true, true);
